{
  "name": "acm-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Agentic Component Manifest (ACM) — a universal, schema-first manifest format describing UI components from any framework for AI agents and tooling. Deterministic canonical JSON interchange, token-frugal Agent View, executable conformance suite.",
  "keywords": [
    "acm",
    "agentic-component-manifest",
    "ai-agents",
    "component-manifest",
    "design-system",
    "ui-components",
    "json-schema",
    "custom-elements-manifest",
    "web-components",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xgentic/agentic-component-manifest.git"
  },
  "homepage": "https://github.com/xgentic/agentic-component-manifest#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:seeded": "vitest run packages/conformance/tests/gate-seeded.test.ts",
    "acm": "tsx packages/toolchain/src/cli.ts",
    "analyze": "tsx packages/analyzer/src/cli.ts analyze",
    "drift": "tsx packages/toolchain/src/cli.ts drift",
    "generate": "tsx packages/toolchain/src/cli.ts drift --write",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.1",
    "ajv": "^8.17.1",
    "eslint": "^9.17.0",
    "gpt-tokenizer": "^2.8.1",
    "json-schema-to-typescript": "^15.0.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0",
    "yaml": "^2.6.1"
  }
}
