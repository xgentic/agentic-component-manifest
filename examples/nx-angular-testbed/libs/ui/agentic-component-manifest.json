    {
      "path": "src/lib/button/button.ts",
      "declarations": [
        {
          "name": "Button",
          "identity": {
            "paradigmClass": "signals-di",
            "module": "@testbed/ui",
            "export": "Button",
            "selector": "tb-button"
          },
          "description": "Triggers a single action when activated.",
          "inputs": [
            {
              "name": "variant",
              "description": "Visual style of the button.",
              "type": {
                "structured": {
                  "kind": "union",
                  "members": [
                    {
                      "kind": "literal",
                      "value": "primary"
                    },
                    {
                      "kind": "literal",
                      "value": "secondary"
                    },
                    {
                      "kind": "literal",
                      "value": "ghost"
                    }
                  ]
                },
                "raw": "'primary' | 'secondary' | 'ghost'"
              },
              "default": "'primary'"
            },
            {
              "name": "size",
              "description": "Size of the button.",
              "type": {
                "structured": {
                  "kind": "union",
                  "members": [
                    {
                      "kind": "literal",
                      "value": "small"
                    },
                    {
                      "kind": "literal",
                      "value": "medium"
                    },
                    {
                      "kind": "literal",
                      "value": "large"
                    }
                  ]
                },
                "raw": "'small' | 'medium' | 'large'"
              },
              "default": "'medium'"
            },
            {
              "name": "disabled",
              "description": "Whether the button is disabled.",
              "type": {
                "structured": {
                  "kind": "primitive",
                  "primitive": "boolean"
                },
                "raw": "boolean"
              },
              "default": "false"
            }
          ],
          "events": [
            {
              "name": "press",
              "description": "Fired when the button is activated by pointer or keyboard.",
              "payload": {
                "structured": {
                  "name": "MouseEvent",
                  "kind": "reference"
                },
                "raw": "MouseEvent"
              }
            }
          ],
          "slots": [
            {
              "description": "Default label content."
            },
            {
              "name": "icon",
              "description": "Leading icon rendered before the label (ng-content select=\"[icon]\")."
            }
          ],
          "semantics": {
            "term": "button",
            "notes": "Triggers the action named by its label; not for navigation."
          },
          "examples": [
            {
              "title": "Primary action",
              "lang": "html",
              "source": "<tb-button variant=\"primary\" (press)=\"save()\">Save</tb-button>"
            },
            {
              "title": "Disabled secondary with a leading icon",
              "lang": "html",
              "source": "<tb-button variant=\"secondary\" size=\"small\" [disabled]=\"true\">\n<svg icon></svg>\nCancel\n</tb-button>"
            }
          ]
        }
      ],
      "exports": [
        {
          "name": "Button",
          "declaration": "Button"
        }
      ]
    },
    {
      "path": "src/lib/card/card.ts",
      "declarations": [
        {
          "name": "Card",
          "identity": {
            "paradigmClass": "signals-di",
            "module": "@testbed/ui",
            "export": "Card",
            "selector": "tb-card"
          },
          "description": "A container that groups related content with an optional header and footer.",
          "inputs": [
            {
              "name": "elevation",
              "description": "Shadow depth, from 0 (flat) to 3 (raised).",
              "type": {
                "structured": {
                  "kind": "union",
                  "members": [
                    {
                      "kind": "literal",
                      "value": 0
                    },
                    {
                      "kind": "literal",
                      "value": 1
                    },
                    {
                      "kind": "literal",
                      "value": 2
                    },
                    {
                      "kind": "literal",
                      "value": 3
                    }
                  ]
                },
                "raw": "0 | 1 | 2 | 3"
              },
              "default": "1"
            }
          ],
          "slots": [
            {
              "description": "Default body content."
            },
            {
              "name": "header",
              "description": "Header content shown above the body (ng-content select=\"[header]\")."
            },
            {
              "name": "footer",
              "description": "Footer content shown below the body (ng-content select=\"[footer]\")."
            }
          ],
          "semantics": {
            "term": "card",
            "notes": "Groups related content as one unit."
          },
          "examples": [
            {
              "title": "Header, body, and footer",
              "lang": "html",
              "source": "<tb-card [elevation]=\"2\">\n<h3 header>Invoice #1042</h3>\nDue in 14 days.\n<tb-button footer variant=\"primary\">Pay now</tb-button>\n</tb-card>"
            }
          ]
        }
      ],
      "exports": [
        {
          "name": "Card",
          "declaration": "Card"
        }
      ]
    },
    {
      "path": "src/lib/checkbox/checkbox.ts",
      "declarations": [
        {
          "name": "Checkbox",
          "identity": {
            "paradigmClass": "signals-di",
            "module": "@testbed/ui",
            "export": "Checkbox",
            "selector": "tb-checkbox"
          },
          "description": "A checkable input for a binary choice.",
          "inputs": [
            {
              "name": "checked",
              "description": "Whether the checkbox is checked.",
              "default": "false"
            },
            {
              "name": "disabled",
              "description": "Whether the checkbox is disabled.",
              "default": "false"
            }
          ],
          "events": [
            {
              "name": "changed",
              "description": "Fired with the new checked state when the checkbox is toggled.",
              "payload": {
                "structured": {
                  "kind": "primitive",
                  "primitive": "boolean"
                },
                "raw": "boolean"
              }
            }
          ],
          "slots": [
            {
              "name": "label",
              "description": "Label content shown next to the checkbox (ng-content select=\"[label]\")."
            }
          ],
          "semantics": {
            "term": "checkbox",
            "notes": "One independent on/off choice; use a radio group for exclusive choices."
          },
          "examples": [
            {
              "title": "Bound checked state",
              "lang": "html",
              "source": "<tb-checkbox [checked]=\"consent\" (changed)=\"consent = $event\">\n<span label>Email me receipts</span>\n</tb-checkbox>"
            }
          ]
        }
      ],
      "exports": [
        {
          "name": "Checkbox",
          "declaration": "Checkbox"
        }
      ]
    },
