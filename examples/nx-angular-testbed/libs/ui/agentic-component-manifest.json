{
  "schemaVersion": "0.1.0",
  "modules": [
    {
      "path": "src/lib/alert/alert.ts",
      "declarations": [
        {
          "name": "Alert",
          "identity": {
            "paradigmClass": "signals-di",
            "module": "@testbed/ui",
            "export": "Alert",
            "selector": "tb-alert"
          },
          "description": "Displays a prominent message about status or a required action.",
          "inputs": [
            {
              "name": "type",
              "description": "Severity of the alert.",
              "type": {
                "structured": {
                  "kind": "union",
                  "members": [
                    {
                      "kind": "literal",
                      "value": "info"
                    },
                    {
                      "kind": "literal",
                      "value": "success"
                    },
                    {
                      "kind": "literal",
                      "value": "warning"
                    },
                    {
                      "kind": "literal",
                      "value": "error"
                    }
                  ]
                },
                "raw": "'info' | 'success' | 'warning' | 'error'"
              },
              "default": "'info'"
            },
            {
              "name": "dismissible",
              "description": "Whether a dismiss control is shown.",
              "type": {
                "structured": {
                  "kind": "primitive",
                  "primitive": "boolean"
                },
                "raw": "boolean"
              },
              "default": "false"
            }
          ],
          "events": [
            {
              "name": "dismissed",
              "description": "Fired when the alert is dismissed via its dismiss control.",
              "payload": {
                "structured": {
                  "kind": "primitive",
                  "primitive": "void"
                },
                "raw": "void"
              }
            }
          ],
          "slots": [
            {
              "description": "Default message content."
            },
            {
              "name": "actions",
              "description": "Action buttons shown alongside the message (ng-content select=\"[actions]\")."
            }
          ]
        }
      ],
      "exports": [
        {
          "name": "Alert",
          "declaration": "Alert"
        }
      ]
    },
