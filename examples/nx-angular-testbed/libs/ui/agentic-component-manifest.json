{
  "schemaVersion": "0.1.0",
  "modules": [
    {
      "path": "src/lib/alert/alert.ts",
      "declarations": [
        {
          "name": "Alert",
          "identity": {
            "paradigmClass": "signals-di",
            "module": "@testbed/ui",
            "export": "Alert",
            "selector": "tb-alert"
          },
          "description": "Displays a prominent message about status or a required action.",
          "inputs": [
            {
              "name": "type",
              "description": "Severity of the alert.",
              "type": {
                "structured": {
                  "kind": "union",
                  "members": [
                    {
                      "kind": "literal",
                      "value": "info"
                    },
                    {
                      "kind": "literal",
                      "value": "success"
                    },
                    {
                      "kind": "literal",
                      "value": "warning"
                    },
                    {
                      "kind": "literal",
                      "value": "error"
                    }
                  ]
                },
                "raw": "'info' | 'success' | 'warning' | 'error'"
              },
              "default": "'info'"
            },
            {
              "name": "dismissible",
              "description": "Whether a dismiss control is shown.",
              "type": {
                "structured": {
                  "kind": "primitive",
                  "primitive": "boolean"
                },
                "raw": "boolean"
              },
              "default": "false"
            }
          ],
          "events": [
            {
              "name": "dismissed",
              "description": "Fired when the alert is dismissed via its dismiss control.",
              "payload": {
                "structured": {
                  "kind": "primitive",
                  "primitive": "void"
                },
                "raw": "void"
              }
            }
          ],
          "slots": [
            {
              "description": "Default message content."
            },
            {
              "name": "actions",
              "description": "Action buttons shown alongside the message (ng-content select=\"[actions]\")."
            }
          ],
          "semantics": {
            "term": "alert",
            "notes": "Announces an important message in place; does not steal focus."
          },
          "examples": [
            {
              "title": "Dismissible error with actions",
              "lang": "html",
              "source": "<tb-alert type=\"error\" [dismissible]=\"true\" (dismissed)=\"onDismiss()\">\nCould not save your changes.\n<tb-button actions variant=\"ghost\">Retry</tb-button>\n</tb-alert>"
            }
          ]
        }
      ],
      "exports": [
        {
          "name": "Alert",
          "declaration": "Alert"
        }
      ]
    },
    {
      "path": "src/lib/avatar/avatar.ts",
      "declarations": [
        {
          "name": "Avatar",
          "identity": {
            "paradigmClass": "signals-di",
            "module": "@testbed/ui",
            "export": "Avatar",
            "selector": "tb-avatar"
          },
          "description": "A round image representing a user or entity.",
          "inputs": [
            {
              "name": "src",
              "description": "Image URL; when absent, the projected fallback content is shown.",
              "type": {
                "structured": {
                  "kind": "primitive",
                  "primitive": "string"
                },
                "raw": "string"
              },
              "default": "''"
            },
            {
              "name": "alt",
              "description": "Accessible alt text for the image.",
              "type": {
                "structured": {
                  "kind": "primitive",
                  "primitive": "string"
                },
                "raw": "string"
              },
              "default": "''"
            },
            {
              "name": "size",
              "description": "Diameter of the avatar.",
              "type": {
                "structured": {
                  "kind": "union",
                  "members": [
                    {
                      "kind": "literal",
                      "value": "small"
                    },
                    {
                      "kind": "literal",
                      "value": "medium"
                    },
                    {
                      "kind": "literal",
                      "value": "large"
                    }
                  ]
                },
                "raw": "'small' | 'medium' | 'large'"
              },
              "default": "'medium'"
            }
          ],
          "slots": [
            {
              "description": "Fallback content shown when no image is available (e.g. initials)."
            }
          ],
          "semantics": {
            "term": "avatar",
            "notes": "Identifies a person or entity; `alt` is the accessible name."
          },
          "examples": [
            {
              "title": "Image with initials fallback",
              "lang": "html",
              "source": "<tb-avatar src=\"/ada.png\" alt=\"Ada Lovelace\" size=\"large\">AL</tb-avatar>"
            }
          ]
        }
      ],
      "exports": [
        {
          "name": "Avatar",
          "declaration": "Avatar"
        }
      ]
    },
